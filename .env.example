# Public browser origin for this Compose setup. Keep it aligned with the OAuth redirect URI.
APP_PORT=8080
FRONTEND_URL=http://localhost:8080
GOOGLE_REDIRECT_URI=http://localhost:8080

# Copy the same Google OAuth Web client ID into both variables.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
VITE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Generate a long random value; never commit the real value.
JWT_SECRET=replace-with-a-long-random-secret

# Required only when RAG_PROVIDER_MODE=studyVault. Leave blank for user-key-only mode.
GEMINI_API_KEY=your-gemini-api-key

# Use studyVault for the server key, or user to require each user to provide their own.
RAG_PROVIDER_MODE=studyVault

# Use development for local HTTP; use production behind HTTPS.
NODE_ENV=development
